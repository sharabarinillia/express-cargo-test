      "status": 301,
      "headers": {
        "Location": "/nl/diensten/luchtvracht/"
      }
    },
    {
      "src": "^/post/.+$",
      "status": 301,
      "headers": {
        "Location": "/nl/"
      }
    },
    {
      "src": "^/en/?$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/en/luchtvracht/?$",
      "status": 301,
      "headers": {
        "Location": "/services/air-freight/"
      }
    },
    {
      "src": "^/en/zeevracht/?$",
      "status": 301,
      "headers": {
        "Location": "/services/sea-freight/"
      }
    },
    {
      "src": "^/en/weg-transport/?$",
      "status": 301,
      "headers": {
        "Location": "/services/road-transport/"
      }
    },
    {
      "src": "^/en/s-projects-basic/?$",
      "status": 301,
      "headers": {
        "Location": "/services/special-projects/"
      }
    },
    {
      "src": "^/en/diensten/?$",
      "status": 301,
      "headers": {
        "Location": "/#services"
      }
    },
    {
      "src": "^/en/over/?$",
      "status": 301,
      "headers": {
        "Location": "/about/"
      }
    },
    {
      "src": "^/en/meet-the-team/?$",
      "status": 301,
      "headers": {
        "Location": "/about/#team"
      }
    },
    {
      "src": "^/en/contact/?$",
      "status": 301,
      "headers": {
        "Location": "/contact/"
      }
    },
    {
      "src": "^/en/vraag-een-offerte-aan/?$",
      "status": 301,
      "headers": {
        "Location": "/contact/#enquiry"
      }
    },
    {
      "src": "^/en/blog/?$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/en/post/dangerous-goods/?$",
      "status": 301,
      "headers": {
        "Location": "/services/air-freight/"
      }
    },
    {
      "src": "^/en/post/.+$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    }
  ]
}
