{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/luchtvracht/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/diensten/luchtvracht/"
      }
    },
    {
      "src": "^/zeevracht/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/diensten/zeevracht/"
      }
    },
    {
      "src": "^/weg-transport/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/diensten/wegtransport/"
      }
    },
    {
      "src": "^/s-projects-basic/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/diensten/projecten/"
      }
    },
    {
      "src": "^/diensten/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/#services"
      }
    },
    {
      "src": "^/over/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/over-ons/"
      }
    },
    {
      "src": "^/meet-the-team/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/over-ons/#team"
      }
    },
    {
      "src": "^/contact$",
      "status": 301,
      "headers": {
        "Location": "/nl/contact/"
      }
    },
    {
      "src": "^/vraag-een-offerte-aan/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/contact/#enquiry"
      }
    },
    {
      "src": "^/blog/?$",
      "status": 301,
      "headers": {
        "Location": "/nl/"
